# Economy combined deployment — union of the api / worker-service env schemas.
# Redis is gone entirely: REDIS_URL and QUEUE_NAME have been removed from both.
# Copy to server/.env for local runs. In Docker/Render, inject these as real
# environment variables instead (docker run --env-file / platform env).
#
# Optional variables are shipped COMMENTED OUT. Uncomment one to use it; never
# leave one as `NAME=` with nothing after it — an empty string is not "unset",
# and an empty URL fails validation and stops the server from booting.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Single public port for HTTP + SSE (one process serves both).
PORT=8080
# Reverse-proxy hops in front of the server (Caddy/Nginx/Render = 1). Sets
# Express "trust proxy" so rate limits and session IPs see the real client.
# 0 if the port is exposed directly.
TRUST_PROXY_HOPS=1
# On SIGTERM, how long running jobs get to finish before exit. Keep it below
# the container stop timeout (compose `stop_grace_period: 60s`).
SHUTDOWN_GRACE_MS=50000

# ── Postgres (the only backing service now) ──────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/tau

# ── Auth — must match the value the api uses to sign access tokens ────────────
ACCESS_TOKEN_SECRET=change-me-to-a-32+char-random-secret
REFRESH_TOKEN_TTL_DAYS=30

# ── App / client URLs ────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
# Marketing site the "Built with tau" badge links visitors to.
LANDING_URL=https://tauai.pro

# ── Deepseek (LLM) — all effort tiers ────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
MODEL_CONTEXT_WINDOW=128000

# ── Kimi / Moonshot — attachment extraction ──────────────────────────────────
# KIMI_EXTRACT_MODEL turns images/documents into text for Deepseek. Without the
# key, image attachments record a per-attachment extraction failure.
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_EXTRACT_MODEL=kimi-k2.6

# ── Attachments ──────────────────────────────────────────────────────────────
# Uploads go browser → R2 directly via presigned PUT, so the R2 bucket needs a
# CORS rule allowing PUT from APP_URL. See doc/PROMPT_ATTACHMENTS.md §3.
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_PER_MESSAGE=5

# ── E2B sandbox ──────────────────────────────────────────────────────────────
E2B_API_KEY=e2b_...

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=tau
# Leave COMMENTED OUT if unused — an empty value fails the URL check and the
# api exits on boot. Same applies to any other optional URL var below.
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# ── Agent / worker ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
MAX_AGENT_DEPTH=3
TAVILY_API_KEY=tvly-...

# ── Credits / billing ────────────────────────────────────────────────────────
CREDITS_ENFORCE=false
CREDITS_MAX_CONCURRENT_JOBS=1

# ── Email (Resend) — optional ────────────────────────────────────────────────
# Unset = verification / confirmation emails fail with 503; the server still boots.
# RESEND_API_KEY=re_...
EMAIL_FROM=Tau <onboarding@resend.dev>

# ── Google OAuth — optional ──────────────────────────────────────────────────
# Unset = /auth/google 404s ("Google sign-in is not configured").
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ── GitHub OAuth — optional (push-to-repo, issues) ───────────────────────────
# Register the callback exactly as GITHUB_REDIRECT_URI in the GitHub OAuth app.
# Mobile uses the same app: it authenticates with a one-shot handoff token
# (POST /auth/github/prepare) instead of the refresh cookie, and the signed
# state carries the client so the callback redirects to tau:// for mobile.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback
# "repo" grants private repos too; narrow to "public_repo" if that's enough.
GITHUB_SCOPE=repo


# Admin console may show user content (prompts, messages, tool IO). Off by
# default — those are the user's words. Every content read is audit-logged.
ADMIN_ALLOW_CONTENT=false
# Slack/Discord incoming webhook for operational alerts. Unset = the hourly
# sweep still computes and logs the numbers, it just doesn't page anyone.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── AI gateway (/v1 + /ai) — optional ────────────────────────────────────────
# Lets a tau-built app call an LLM on its owner's credits.
# See doc/AI_FOR_GENERATED_APPS.md.
#
# Encrypts stored tau_sk_* keys at rest (AES-256-GCM). 32 bytes, hex:
#   openssl rand -hex 32
# Optional only so an existing deployment still boots without it. Unset means
# /v1 does not mount and enable_ai is disabled — the feature does not ship
# unencrypted, it just doesn't ship. LOSING THIS MAKES EVERY EXISTING KEY
# UNDECRYPTABLE: back it up separately from the database.
# TAU_KEY_ENC_SECRET=

# Base URL a generated app fetches — `${TAU_AI_URL}/chat`. MUST be reachable
# from inside an E2B sandbox (a remote VM), so localhost/LAN values are wrong,
# not just inconvenient. Deliberately has no default; enable_ai refuses loudly
# rather than shipping an app whose AI calls connect-refuse.
# TAU_AI_URL=https://api.example.com/ai
# The OpenAI-compatible base, for pointing an SDK at tau from outside a sandbox.
# TAU_API_URL=https://api.example.com/v1

# Gateway enforcement is SEPARATE from CREDITS_ENFORCE and defaults to true:
# a build in shadow mode costs tau one job, an unenforced gateway is an open,
# unbilled LLM proxy. Leave this alone unless you know why.
GATEWAY_ENFORCE=true
# Per-request output cap; bounds the check-then-charge overshoot window.
GATEWAY_MAX_OUTPUT_TOKENS=4096
# In-flight ceilings — per key, then process-wide. The global one keeps runtime
# inference from starving the build queue it shares a process with.
GATEWAY_MAX_CONCURRENT=8
GATEWAY_MAX_CONCURRENT_GLOBAL=32
GATEWAY_RPM=60
# Default daily ceiling per key, micro-credits (20 credits). A deployed app's
# endpoints are public by default; this is the backstop against one draining
# the owner's balance overnight. Per-key overrides live on the ApiKey row.
GATEWAY_DEFAULT_DAILY_CAP_MICRO=20000000
GATEWAY_MIN_BALANCE_MICRO=100000

# ── Published sites (deploys) — optional ─────────────────────────────────────
# Everything here is optional and publishing works fully without it: with no
# SITES_DOMAIN, sites are served from this server at
# `{SITES_ORIGIN}/sites/{slug}/`. Setting a domain switches the URL users are
# given to `https://{slug}.{SITES_DOMAIN}` — which needs a wildcard DNS record
# (`*.usetau.app`) pointing here, and a wildcard certificate.
# SITES_DOMAIN=usetau.app
# Public origin of THIS server, used to build the path-based URL when
# SITES_DOMAIN is unset. Defaults to http://localhost:${PORT}.
# SITES_ORIGIN=https://api.example.com
# Ceilings on one published build. Exceeding either is a build gone wrong (a
# dist/ containing node_modules, a stray video) — better to fail loudly than to
# quietly upload it. Bytes default to 100 MB.
DEPLOY_MAX_FILES=2000
DEPLOY_MAX_BYTES=104857600
# How long a project's build may run before it is abandoned.
DEPLOY_BUILD_TIMEOUT_MS=300000

# ── Razorpay — optional ──────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Must reference the ₹1,499/month Razorpay plan. Changing UI/catalog constants
# does not change an existing Razorpay plan's charge amount.
# RAZORPAY_PRO_PLAN_ID=
