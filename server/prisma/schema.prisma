// The single source of truth for the database.
//
// This file existed twice (api/ and worker-service/, byte-identical, synced by
// hand) until phase 2 collapsed it to one. Phase 2 still needed *two* generator
// blocks, because each service resolved @prisma/client from its own
// node_modules. Phase 5 merged the services, so there is one node_modules and
// therefore one client. Import it as `@/generated/prisma/...`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())

  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  projects      Project[]
  tokenUsage    TokenUsage[]

  billing       BillingAccount?
  promoRedeems  PromoRedemption[]
  subscriptions Subscription[]
  attachments   Attachment[]
  apiKeys       ApiKey[]
}

model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum ClientType {
  web
  mobile
}

model RefreshToken {
  id         String     @id @default(uuid())
  userId     String
  tokenHash  String     @unique
  clientType ClientType
  deviceInfo Json?
  createdAt  DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sandboxId        String?
  sandboxStatus    SandboxStatus @default(NONE)
  sandboxExpiresAt DateTime?

  templateKey String @default("fullstack")

  /// Set by the `enable_ai` tool. Drives re-injection of TAU_API_KEY into the
  /// sandbox on every provision — the key lives in a `.env` that is deliberately
  /// never persisted to the manifest, so it has to be rewritten each rebuild.
  aiEnabled Boolean @default(false)

  previewImageKey       String?
  previewImageUpdatedAt DateTime?

  /// The subdomain this project's published site is served from. Allocated on
  /// the first publish and never reused, because a slug that changes hands
  /// would silently point somebody else's links at a different app.
  slug String? @unique

  /// The deployment currently served at `slug`. Every build writes to its own
  /// immutable R2 prefix, so publishing is this one pointer moving — which is
  /// also what makes rollback a single UPDATE.
  liveDeploymentId String?

  // "owner/repo" once the first GitHub push creates/links a repo; null before.
  githubRepo String?

  githubDefaultBranch String?
  githubVisibility    String?
  lastPushedBranch    String?
  lastPrUrl           String?
  lastPrNumber        Int?
  lastPushedSequence  Int?
  githubPushMode      String  @default("new_pr") // new_pr | update_pr | direct

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  jobs       Job[]
  tokenUsage TokenUsage[]

  headSequence Int           @default(0)
  files        ProjectFile[]

  contextCheckpoints ContextCheckpoint[]
  deployments        Deployment[]

  @@index([userId])
}

enum SandboxStatus {
  NONE
  PROVISIONING
  READY
  HIBERNATED
  DEAD
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  USER
  RESULT
  ERROR
  TOOL_REQ
  TOOL_RES
  USER_EDIT
}

model Message {
  id   String      @id @default(uuid())
  role MessageRole
  type MessageType

  content  Json
  sequence Int

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  fragment    Fragment?
  toolCalls   ToolCall[]
  attachments Attachment[]

  @@unique([projectId, sequence])
  @@index([projectId])
  @@index([jobId])
}

enum AttachmentKind {
  IMAGE
  PASTED
  FILE
}

enum AttachmentStatus {
  PENDING
  EXTRACTING
  READY
  FAILED
}

// Extracted text is materialized into Message.content at send time, so this
// table is only for the UI (chips, preview, download) and provenance.
model Attachment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   AttachmentKind
  status AttachmentStatus @default(PENDING)

  filename  String
  mimeType  String
  sizeBytes Int

  // Null for PASTED — the text is the payload.
  blobKey     String?
  // sha256 of the bytes; drives the extraction cache.
  contentHash String?

  // What the agent actually sees. For PASTED this is the raw paste.
  extractedText   String?
  extractionError String?

  // First ~240 chars of extractedText, denormalised so the chat transcript can
  // render a paste chip without dragging the whole (up to 500KB) body along.
  preview String?

  extractionModel  String?
  extractionTokens Int     @default(0)

  // Null until the message is sent. Orphans are swept hourly.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([messageId])
  @@index([userId, contentHash])
}

model ToolCall {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  toolCallId String
  toolName   String
  input      Json

  status      ToolCallStatus @default(PENDING)
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([toolCallId])
}

enum ToolCallStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Job {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status JobStatus @default(QUEUED)
  type   JobType   @default(GENERATION)
  prompt String
  effort Effort    @default(LOW)

  queueJobId String? @unique

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  error         String?
  attemptNumber Int     @default(1)
  maxAttempts   Int     @default(2)

  // Liveness. The runner is in-process with no durability, so a crash/redeploy
  // can strand a row at RUNNING forever. The agent loop bumps this every turn;
  // the reaper (api/src/lib/jobs.ts) terminates rows whose heartbeat went cold.
  lastHeartbeatAt DateTime?
  currentTurn     Int       @default(0)

  // How the run ended. Distinct from `status`: a job can be COMPLETED because
  // it finished, or because it ran out of budget mid-task.
  finishReason FinishReason?

  // Operational rollups, written as the run ends. All of this is derivable by
  // joining TokenUsage/Message, but the admin views read it per-row and per-
  // window — denormalising keeps those queries a single scan instead of a join
  // over every turn of every job.
  model        String?
  sandboxId    String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costMicro    BigInt  @default(0)

  messages   Message[]
  tokenUsage TokenUsage[]
  fragments  Fragment[]

  @@index([projectId])
  @@index([status])
  @@index([status, lastHeartbeatAt])
  @@index([queuedAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Why a run ended, recorded alongside `Job.status`. `status` says whether the
/// job succeeded; this says what actually stopped it — the distinction an
/// operator needs to tell a model that loops (TURN_CAP) from one that overruns
/// its response limit (TRUNCATION_CAP) from one that hangs (WALL_CLOCK), all of
/// which otherwise collapse into a single FAILED row.
enum FinishReason {
  /// The agent finished the task and sent its final message.
  DONE
  /// Hit the per-request credit ceiling mid-task.
  BUDGET
  /// The account ran out of credits mid-task.
  INSUFFICIENT_CREDITS
  /// Stopped by the user.
  CANCELLED
  /// Exceeded `EffortBudget.maxAgentTurns` without finishing.
  TURN_CAP
  /// Response truncated at the token limit `MAX_TRUNCATION_RETRIES` times.
  TRUNCATION_CAP
  /// Exceeded `EffortBudget.maxWallClockMs` — wedged rather than working.
  WALL_CLOCK
  /// Any other failure; see `Job.error` for the message.
  ERROR
  /// The owning process died and the reaper cleaned the row up.
  ABANDONED
}

enum JobType {
  GENERATION
  RECOVERY
  PREVIEW
  DEPLOY
}

enum Effort {
  LOW
  HIGH
  MAX
}

model ProjectFile {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  path         String
  contentHash  String
  sizeBytes    Int
  lastSequence Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

model ContextCheckpoint {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  upToSequence Int

  summary      String
  tokensBefore Int
  tokensAfter  Int

  jobId     String?
  createdAt DateTime @default(now())

  @@index([projectId, upToSequence])
}

model Fragment {
  id        String  @id @default(uuid())
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl  String
  title       String
  description String?

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usage {
  key    String    @id
  points Int
  expire DateTime?
}

model TokenUsage {
  id        String @id @default(uuid())
  userId    String
  projectId String
  jobId     String
  model     String

  inputTokens  Int
  outputTokens Int

  recordedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([projectId])
  @@index([jobId])
  @@index([recordedAt])
}

// ─────────────────────────────── Deployments ─────────────────────────────────

enum DeploymentStatus {
  QUEUED
  /// Running the project's build command inside its sandbox.
  BUILDING
  /// Build succeeded; copying the static output into R2.
  UPLOADING
  /// Serving. At most one deployment per project is READY *and* pointed at by
  /// `Project.liveDeploymentId`; older READY rows are kept for rollback.
  READY
  FAILED
  /// Superseded by a newer deployment. Its bytes are still in R2 until swept.
  SUPERSEDED
}

/// One published build of a project's static output.
///
/// Deliberately immutable and append-only: each row owns an R2 prefix keyed by
/// its own id, so a build never overwrites the bytes a live site is serving. A
/// publish is therefore "upload everything, then move one pointer" — the live
/// site never sees a half-uploaded state, and rollback is moving the pointer
/// back rather than rebuilding.
model Deployment {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Denormalised from Project so this row is self-sufficient: `storagePrefix`
  /// is scoped under the owner (matching `tau/project-files/{userId}/…`), and a
  /// per-user cleanup sweep can list R2 by prefix without a join.
  userId String

  status DeploymentStatus @default(QUEUED)

  /// R2 prefix holding this build's output, without a trailing slash.
  storagePrefix String

  /// `Project.headSequence` when the build started: which version of the file
  /// manifest these bytes were built from.
  sequence Int @default(0)

  /// The directory inside the sandbox the output was collected from ("dist").
  outputDir String?

  fileCount Int @default(0)
  sizeBytes Int @default(0)

  /// The DEPLOY job that produced this row. Nullable because the row is created
  /// before the job is enqueued, in the same transaction that reserves it.
  jobId String? @unique

  /// What the user needs to told about this build, if anything. `status` says
  /// how to read it: on FAILED it is why it failed, on READY it is a caveat
  /// (e.g. the type check was bypassed). One field rather than two because the
  /// UI shows it in one place either way, and a deployment never has both.
  error String?

  /// Tail of the build output. Truncated on write — a full build log belongs in
  /// the job stream, not in a column every list query reads.
  buildLog String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  /// When this deployment's R2 objects were reclaimed. The row survives — it is
  /// the history of what was published — but its bytes are gone and it can no
  /// longer be rolled back to. Set rather than inferred so the sweep can skip
  /// already-purged rows instead of re-listing an empty prefix every hour.
  purgedAt DateTime?

  @@index([projectId, createdAt])
  @@index([status])
  @@index([purgedAt, completedAt])
}

// ───────────────────────────── Credits & billing ─────────────────────────────

enum Plan {
  FREE
  PRO
}

// One row per user; the row we lock (SELECT … FOR UPDATE) to serialize spend.
model BillingAccount {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan Plan @default(FREE)

  freeBalance  BigInt @default(0) // one-time signup free grant (never refilled)
  planBalance  BigInt @default(0) // monthly-reset bucket (active plan)
  bonusBalance BigInt @default(0) // never expires (promos, top-ups, refunds)
  reserved     BigInt @default(0) // sum of ACTIVE holds; earmark, not a ledger event

  // Legacy — retained for backward compatibility only. Free credits are no
  // longer refilled daily, so these are unused by current code.
  dailyAllotment BigInt    @default(0)
  freeRefilledAt DateTime?

  cycleStart DateTime? // current plan billing cycle
  cycleEnd   DateTime?

  razorpayCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger CreditLedger[]
  holds  CreditHold[]
}

enum LedgerType {
  SIGNUP_GRANT
  DAILY_FREE_GRANT
  PLAN_GRANT
  PROMO_REDEEM
  PURCHASE
  DEBIT
  REFUND
  EXPIRE
  ADJUSTMENT
  /// Runtime inference through the /v1 gateway, spent by a generated app rather
  /// than by a build. Distinct from DEBIT so /billing and the admin views can
  /// split "building" from "app usage" with a `where`, not a string match.
  GATEWAY_DEBIT
}

// Append-only money record. Invariant (gross balance) == Σ amount per account.
model CreditLedger {
  id      String         @id @default(uuid())
  userId  String
  account BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  type         LedgerType
  amount       BigInt // signed micro-credits (+grant / −debit)
  balanceAfter BigInt // gross (free+plan+bonus) snapshot, for audit

  jobId             String?
  holdId            String?
  promoRedemptionId String?
  paymentId         String?

  idempotencyKey String?  @unique // dedupes retries & webhook redelivery
  reason         String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
}

enum HoldStatus {
  ACTIVE
  SETTLED
  RELEASED
}

// One hold per job — the reserved ceiling a job may spend.
model CreditHold {
  id      String         @id @default(uuid())
  userId  String
  account BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  jobId   String         @unique

  amount   BigInt // reserved ceiling
  consumed BigInt     @default(0) // metered so far against this hold
  status   HoldStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@index([userId])
}

model PromoCode {
  id          String  @id @default(uuid())
  code        String  @unique // store normalized (uppercased, trimmed)
  credits     BigInt // micro-credits granted to bonusBalance
  description String?

  maxRedemptions Int? // null = unlimited
  redeemedCount  Int  @default(0)
  perUserLimit   Int  @default(1)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt   DateTime          @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id     String    @id @default(uuid())
  codeId String
  code   PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  creditsGranted BigInt
  createdAt      DateTime @default(now())

  @@unique([codeId, userId]) // DB-enforced single redemption per user
  @@index([userId])
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   Plan
  status SubscriptionStatus

  razorpaySubscriptionId String  @unique
  razorpayPlanId         String
  razorpayCustomerId     String?

  currentStart     DateTime?
  currentEnd       DateTime?
  cancelAtCycleEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ───────────────────────────── AI gateway (/v1) ──────────────────────────────

enum ApiKeyStatus {
  ACTIVE
  /// Superseded by a rotation but still honored until `revokeAfter`. Without
  /// the overlap, rotating a key breaks every deployed app the instant it
  /// happens, with no window to redeploy.
  ROTATING
  REVOKED
}

/// A user's key for the OpenAI-compatible `/v1` gateway, which generated apps
/// use to call an LLM on the owner's credits. See doc/AI_FOR_GENERATED_APPS.md.
///
/// `userId` is deliberately NOT unique: the rotation grace window means a user
/// briefly holds an ACTIVE key and a ROTATING one. "Exactly one usable key" is
/// enforced in the service layer instead.
model ApiKey {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256(rawKey), hex. The auth lookup index — we never scan and compare, so
  /// there is no timing side channel and no table scan per request.
  lookupHash String @unique
  /// "v1:{iv}:{tag}:{ciphertext}", AES-256-GCM under TAU_KEY_ENC_SECRET.
  /// Reversible because tau must inject the plaintext into sandboxes and
  /// deploys. Versioned so the encryption key itself can be rotated later.
  ciphertext String
  /// "tau_sk_live_ab12cd34" — safe to render anywhere, including logs.
  prefix     String

  status ApiKeyStatus @default(ACTIVE)

  /// Per-key daily ceiling in micro-credits. Null = the global default. This is
  /// the backstop against a deployed app draining the owner's balance: its
  /// endpoints are public and unauthenticated by default.
  dailyCapMicro BigInt?

  /// Throttled to at most one write a minute — this is for the profile UI, not
  /// an audit log.
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// Set on rotate: the moment this key stops being honored.
  revokeAfter DateTime?
  revokedAt   DateTime?

  usage GatewayUsage[]

  @@index([userId, status])
}

/// One row per gateway request.
///
/// Deliberately NOT TokenUsage: that table's jobId/projectId FKs are non-null
/// with onDelete: Restrict, and reconcileJob() plus every admin rollup joins on
/// jobId. Runtime inference has no job, so widening TokenUsage to nullable would
/// silently change all of those.
model GatewayUsage {
  id       String @id @default(uuid())
  userId   String
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  /// From the X-Tau-Project header. Null when the caller didn't send it.
  /// Spoofable by the key owner, which is fine — they're their own credits.
  projectId String?

  /// What the app asked for ("tau-fast") vs what we actually called
  /// ("deepseek-v4-flash"). `model` is the costMicro() key; `alias` is what the
  /// user's code says, so a provider swap stays legible in the ledger.
  alias String
  model String

  inputTokens  Int
  outputTokens Int
  costMicro    BigInt

  /// Echoed to the caller as `x-tau-request-id`. Drives DEBIT idempotency.
  requestId String @unique
  /// Upstream HTTP status, so a failed proxy attempt is still recorded.
  status    Int

  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
  @@index([apiKeyId, recordedAt])
  @@index([projectId])
}

// Idempotent webhook processing (Razorpay can redeliver events).
model WebhookEvent {
  id          String    @id // provider event id (e.g. x-razorpay-event-id)
  provider    String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}
