# ─────────────────────────────────────────────────────────────
# SHARED — keep identical across api / worker-service
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgres://tau:tau@localhost:5432/tau"

# ─────────────────────────────────────────────────────────────
# worker-service-specific
# ─────────────────────────────────────────────────────────────
# Deepseek (LLM) — shared with api
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Optional: defaults shown below
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
# Usable context window (tokens) — drives context compaction/summarization.
MODEL_CONTEXT_WINDOW=128000

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_MAX=kimi-k2.7-code

# E2B sandbox
E2B_API_KEY=e2b-your-api-key

# R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=tau-files
R2_PUBLIC_BASE_URL=https://files.example.com

# Worker (optional: default shown below)
WORKER_CONCURRENCY=3

# Credits / billing — "true" enforces credit charging; "false" = shadow mode
CREDITS_ENFORCE=false
# Maximum simultaneous active jobs per user (0 = no cap; default 3)
CREDITS_MAX_CONCURRENT_JOBS=1

# Tavily (web_search tool)
TAVILY_API_KEY=tvly-your-tavily-key

# ── AI features in generated apps (doc/AI_FOR_GENERATED_APPS.md) ──
# 32 random bytes as hex. Must match the api service — the worker decrypts the
# same rows the api encrypted. Unset disables `enable_ai` entirely.
TAU_KEY_ENC_SECRET=
#
# Where a generated app sends its AI calls. These are read INSIDE an E2B sandbox,
# which is a remote VM: a localhost value is the sandbox's own loopback and every
# call will connect-refuse. There is deliberately no default — set both to a
# publicly reachable origin (in dev, a tunnel such as `cloudflared` or `ngrok`
# pointed at the api service).
TAU_AI_URL=https://api.example.com/ai
TAU_API_URL=https://api.example.com/v1
#
# Set to "true" only to test injection mechanics (does .env land, does the Hono
# restart work) without standing up a tunnel. Downgrades an unreachable URL from
# a refusal to a warning; the generated app's AI calls will still fail.
TAU_GATEWAY_ALLOW_UNREACHABLE=false
