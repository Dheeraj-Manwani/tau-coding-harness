# ─────────────────────────────────────────────────────────────
# SHARED — keep identical across api / ws-gateway / worker-service
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgres://tau:tau@localhost:5432/tau"
REDIS_URL=redis://localhost:6379

# Signs the HS256 access/connection tokens. ws-gateway verifies with this.
ACCESS_TOKEN_SECRET=change-me-min-16-chars

# ─────────────────────────────────────────────────────────────
# api-specific
# ─────────────────────────────────────────────────────────────
PORT=3000

# Deepseek (LLM) — shared with worker-service
DEEPSEEK_API_KEY=sk-your-deepseek-key

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_EXTRACT_MODEL=kimi-k2.6

ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_PER_MESSAGE=5

# Email (Resend)
EMAIL_FROM=Tau <onboarding@resend.dev>
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credits / billing — "true" enforces credit charging; "false" = shadow mode
CREDITS_ENFORCE=false
# Maximum simultaneous active jobs per user (0 = no cap; default 3)
CREDITS_MAX_CONCURRENT_JOBS=1

# Admin API key 
ADMIN_API_KEY=

# Create a plan in the Razorpay dashboard (monthly, INR) and paste its ID below.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=plan_xxxxxxxxxxxx

# ── AI gateway (/v1) ──────────────────────────────────────────────────────────
# Encrypts stored tau_sk_* API keys at rest. Required for /v1 to mount at all.
#   openssl rand -hex 32
TAU_KEY_ENC_SECRET=
# Separate from CREDITS_ENFORCE and defaults to true on purpose: a gateway in
# shadow mode is an open, unbilled LLM proxy.
GATEWAY_ENFORCE=true
GATEWAY_MAX_OUTPUT_TOKENS=4096
GATEWAY_RPM=60
GATEWAY_MAX_CONCURRENT=8
# Daily spend ceiling per key, in micro-credits (20 credits).
GATEWAY_DEFAULT_DAILY_CAP_MICRO=20000000
GATEWAY_MIN_BALANCE_MICRO=100000
# Wall-clock backstop per stream. Bun's http layer cannot detect a client
# disconnect on this route, so this is what stops an abandoned stream.
GATEWAY_STREAM_TIMEOUT_MS=300000

# Where generated apps reach tau AI. Read by the worker, consumed INSIDE an E2B
# sandbox — a remote VM — so a localhost value is the sandbox's own loopback and
# every AI call connect-refuses. There is deliberately no default; in dev, point
# these at a tunnel (cloudflared / ngrok) terminating on this api service.
# The plain-fetch surface generated apps use by default: ${TAU_AI_URL}/chat
TAU_AI_URL=https://api.example.com/ai
# The OpenAI-compatible surface, for SDK callers outside the sandbox.
TAU_API_URL=https://api.example.com/v1
# "true" only to test injection mechanics without a tunnel. Downgrades an
# unreachable URL from a refusal to a warning; AI calls will still fail.
TAU_GATEWAY_ALLOW_UNREACHABLE=false
