# Economy combined deployment — union of api / ws-gateway / worker-service env
# schemas, MINUS Redis (REDIS_URL / QUEUE_NAME are no longer used).
# Copy to deploy/.env for local runs. In Docker/Render, inject these as real
# environment variables instead (docker run --env-file / platform env).

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Single public port for HTTP + SSE (api :3000 and ws-gateway :3001 are merged).
PORT=8080

# ── Postgres (the only backing service now) ──────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/tau

# ── Auth — must match the value the api uses to sign access tokens ────────────
ACCESS_TOKEN_SECRET=change-me-to-a-32+char-random-secret
REFRESH_TOKEN_TTL_DAYS=30

# ── App / client URLs ────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# ── Deepseek (LLM) — LOW and HIGH effort ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
MODEL_CONTEXT_WINDOW=128000

# ── Kimi / Moonshot — MAX effort + attachment extraction ─────────────────────
# One key serves both: worker-service uses KIMI_MODEL_MAX for the MAX tier, api
# uses KIMI_EXTRACT_MODEL to turn images/documents into text for Deepseek.
# Both degrade SILENTLY without the key — MAX falls back to DEEPSEEK_MODEL and
# image attachments record a per-attachment extraction failure. Set it.
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_MAX=kimi-k2.7-code
KIMI_EXTRACT_MODEL=kimi-k2.6

# ── Attachments ──────────────────────────────────────────────────────────────
# Uploads go browser → R2 directly via presigned PUT, so the R2 bucket needs a
# CORS rule allowing PUT from APP_URL. See doc/PROMPT_ATTACHMENTS.md §3.
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_IMAGE_BYTES=5242880
ATTACHMENT_MAX_PER_MESSAGE=5

# ── E2B sandbox ──────────────────────────────────────────────────────────────
E2B_API_KEY=e2b_...

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=tau
# Leave COMMENTED OUT if unused — an empty value fails the URL check and the
# api exits on boot. Same applies to any other optional URL var below.
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# ── Agent / worker ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
MAX_AGENT_DEPTH=3
TAVILY_API_KEY=tvly-...

# ── Credits / billing ────────────────────────────────────────────────────────
CREDITS_ENFORCE=false
CREDITS_MAX_CONCURRENT_JOBS=1

# ── Email (Resend) — optional ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Tau <onboarding@resend.dev>

# ── Google OAuth — optional ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ── Admin — optional ─────────────────────────────────────────────────────────
ADMIN_API_KEY=

# ── Razorpay — optional ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
