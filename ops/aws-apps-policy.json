{
  "_comment": "Replace ACCOUNT_ID and REGION. Policy 1 -> the tau-server IAM user (AWS_APPS_ACCESS_KEY_ID). Policy 2 -> the tau-router IAM user (wrangler secret AWS_ACCESS_KEY_ID). Policy 3 is the permissions boundary (AWS_APPS_PERMISSIONS_BOUNDARY_ARN): every app role is created with it, so an app can never be more than logs.",
  "server_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AppFunctions",
        "Effect": "Allow",
        "Action": [
          "lambda:CreateFunction", "lambda:DeleteFunction", "lambda:GetFunction", "lambda:GetFunctionConfiguration",
          "lambda:UpdateFunctionCode", "lambda:UpdateFunctionConfiguration", "lambda:PublishVersion",
          "lambda:PutFunctionConcurrency", "lambda:CreateAlias", "lambda:UpdateAlias", "lambda:DeleteAlias",
          "lambda:ListAliases", "lambda:ListVersionsByFunction", "lambda:DeleteFunctionUrlConfig",
          "lambda:CreateFunctionUrlConfig", "lambda:UpdateFunctionUrlConfig", "lambda:GetFunctionUrlConfig",
          "lambda:InvokeFunctionUrl", "lambda:InvokeFunction", "lambda:AddPermission", "lambda:RemovePermission"
        ],
        "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:tau-app-*"
      },
      {
        "Sid": "AppRoles",
        "Effect": "Allow",
        "Action": ["iam:CreateRole", "iam:GetRole", "iam:DeleteRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy"],
        "Resource": ["arn:aws:iam::ACCOUNT_ID:role/tau-apps/*", "arn:aws:iam::ACCOUNT_ID:role/tau-app-*"],
        "Condition": { "StringEquals": { "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/tau-app-boundary" } }
      },
      {
        "Sid": "AppRolesRead",
        "Effect": "Allow",
        "Action": ["iam:GetRole", "iam:DeleteRole", "iam:DeleteRolePolicy"],
        "Resource": ["arn:aws:iam::ACCOUNT_ID:role/tau-apps/*", "arn:aws:iam::ACCOUNT_ID:role/tau-app-*"]
      },
      {
        "Sid": "PassOnlyAppRoles",
        "Effect": "Allow",
        "Action": "iam:PassRole",
        "Resource": ["arn:aws:iam::ACCOUNT_ID:role/tau-apps/*", "arn:aws:iam::ACCOUNT_ID:role/tau-app-*"],
        "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
      },
      {
        "Sid": "AppLogs",
        "Effect": "Allow",
        "Action": ["logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:FilterLogEvents", "logs:DescribeLogStreams", "logs:GetLogEvents"],
        "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/tau-app-*:*"
      }
    ]
  },
  "router_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "InvokeAppsOnly",
        "Effect": "Allow",
        "Action": ["lambda:InvokeFunctionUrl", "lambda:InvokeFunction"],
        "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:tau-app-*"
      }
    ]
  },
  "boundary_policy_named_tau-app-boundary": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
        "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/tau-app-*:*"
      }
    ]
  }
}
