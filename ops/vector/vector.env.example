# Vector's credentials for Grafana Cloud Loki. Lives at /opt/tau/vector/vector.env
# on the box (chmod 600), separate from the app's .env on purpose.
#
# Grafana Cloud → your stack → Loki → "Details":
#   URL  = the Loki endpoint, WITHOUT /loki/api/v1/push (Vector appends it)
#   USER = the numeric Loki user / instance id
#   TOKEN = an access policy token with the logs:write scope only
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net
GRAFANA_LOKI_USER=000000
GRAFANA_LOKI_TOKEN=glc_...
