# The tau API this console reads from. Everything it shows comes from the
# role-gated /admin/* endpoints there — this app holds no data and no secrets.
#
# The server must have ADMIN_URL set to this app's origin (CORS on /admin and
# Google sign-in), and the two must share a registrable domain so the
# SameSite=Lax admin cookie reaches the API:
#   prod: admin.tauai.pro  ↔  api.tauai.pro   (ADMIN_URL=https://admin.tauai.pro)
#   dev:  localhost:5175   ↔  localhost:8080  (ADMIN_URL=http://localhost:5175)
VITE_API_URL=http://localhost:8080
